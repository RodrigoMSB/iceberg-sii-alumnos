# Saltos de linea LF siempre, aunque el repositorio se clone desde Windows.
# Un script o un archivo de configuracion con CRLF falla dentro de los
# contenedores, que son Linux: bash lee el \r como parte del comando.

*.sh            text eol=lf
*.py            text eol=lf
*.scala         text eol=lf
*.sbt           text eol=lf
Dockerfile      text eol=lf

# Configuracion
*.conf          text eol=lf
*.ini           text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.properties    text eol=lf
*.toml          text eol=lf
.env.example    text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf

# Las guias son binarias: git no las toca.
*.pdf           binary
