# Copia este archivo a .env y cambia el token por uno tuyo.
#
#   cp .env.example .env
#
# El .env NO se sube al repositorio: esta en .gitignore.

# La clave con la que entras a JupyterLab. Pon cualquier cosa larga que
# recuerdes; es lo unico que separa tu ambiente de otro programa en tu maquina.
JUPYTER_TOKEN=cambia-esto-por-algo-tuyo

# Puertos, por si alguno ya esta ocupado en tu maquina.
JUPYTER_PORT=8888
NAMENODE_UI_PORT=9870

# --- Solo si usas el perfil 'sql' (laboratorios 02 y 07) -------------------
HUE_PORT=8889
HUE_SECRET_KEY=cambia-esta-clave-tambien
