<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Hive Metastore 3.1.3 -> PostgreSQL 15, warehouse en HDFS.
  Sin Kerberos: autenticacion simple (fuera de alcance de SPEC-001).
-->
<configuration>

  <!-- Backend del metastore -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://postgres:5432/metastore</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>hive</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>hive</value>
  </property>

  <!-- Warehouse en HDFS: el cliente usa HDFS, no object storage. -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>hdfs://namenode:8020/warehouse/iceberg</value>
  </property>
  <property>
    <name>metastore.warehouse.dir</name>
    <value>hdfs://namenode:8020/warehouse/iceberg</value>
  </property>

  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>metastore.thrift.port</name>
    <value>9083</value>
  </property>

  <!-- El esquema lo crea schematool en el entrypoint; no auto-crear al vuelo. -->
  <property>
    <name>datanucleus.schema.autoCreateAll</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>true</value>
  </property>

  <!-- Sin Kerberos -->
  <property>
    <name>hive.metastore.sasl.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>metastore.use.SSL</name>
    <value>false</value>
  </property>

  <!-- Necesario para que HiveServer2 (plan A) entienda tablas Iceberg. -->
  <property>
    <name>iceberg.engine.hive.enabled</name>
    <value>true</value>
  </property>

  <!-- HiveServer2 (plan A): autenticacion simple, sin doAs para que el warehouse
       compartido no dependa del usuario del sistema operativo. -->
  <property>
    <name>hive.server2.authentication</name>
    <value>NONE</value>
  </property>
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>hive.server2.thrift.port</name>
    <value>10000</value>
  </property>

  <!-- Lab de un solo nodo: sin control de concurrencia distribuido de Hive.
       El aislamiento de escrituras concurrentes lo da Iceberg (CA-10). -->
  <property>
    <name>hive.support.concurrency</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>

</configuration>
